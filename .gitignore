# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- 他人に見られて困るファイルはコミットしない（CLAUDE.md「秘密情報の扱い」） ----
# 鍵・証明書
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
# クラウドの認証情報
*service-account*.json
*credentials*.json
.secrets/
secrets/
# Supabase CLI のローカル状態（DBのパスワードなどを含むことがある）
supabase/.temp/
supabase/.branches/
supabase/.env
# データベースのダンプ（利用者の会話を含みうる）
*.dump
*.sql.gz
dump*.sql
backup*.sql

# 環境変数の見本だけはコミットする（値は空にしておく）
!.env.example
