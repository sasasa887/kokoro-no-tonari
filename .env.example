# Claude API。未設定のときはデモ用のモック返答で動く
ANTHROPIC_API_KEY=

# モデルの切り替え（企画書：対話は Haiku 5.5 と Opus 5.5 を比べて決める）
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low
REFLECTION_MODEL=claude-opus-5-5

# Cookie の署名キー（32文字以上）。本番では必須。作り方: openssl rand -base64 48
SESSION_SECRET=

# 1日の発言数の上限（1人あたり／同じIPあたり）
DAILY_MESSAGE_LIMIT=60
DAILY_MESSAGE_LIMIT_PER_IP=200

# 会話本文の暗号化キー（32バイトを base64）。作り方: openssl rand -base64 32
CONTENT_ENCRYPTION_KEY=

# Supabase（「ログインとDB」で接続する）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 本番で APIキーなしのモック返答を使う場合だけ 1 にする（デモ用）
DEMO_MODE=
